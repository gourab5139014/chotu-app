{
  "name": "@chotu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "chotu": "./src/bin/chotu.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate --config drizzle.pg.config.ts && drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:check": "drizzle-kit check --config drizzle.pg.config.ts && drizzle-kit check --config drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.14.1",
    "better-sqlite3": "11.8.1",
    "drizzle-orm": "0.39.3",
    "hono": "4.7.4",
    "openid-client": "6.8.7",
    "postgres": "3.4.5",
    "zod": "3.24.2",
    "@node-rs/argon2": "2.0.2",
    "uuidv7": "1.0.2",
    "zod-to-json-schema": "3.24.1",
    "yaml": "2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.17.19",
    "drizzle-kit": "0.30.4",
    "jose": "5.10.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}

# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real secret values.
# This file grows as the code lands. Keep it in sync with the spec.
# See specs/constitution.md for the stack and specs/0001-*/ for M1.

# ===========================================================================
# API service  (packages/api)
# ===========================================================================

# --- Database -------------------------------------------------------------
# The adapter is chosen from the URL scheme.
#   PostgreSQL:  postgres://user:pass@host:5432/chotu
#   SQLite:      file:./chotu.db
DATABASE_URL=file:./chotu.db

# --- Schema bootstrap ---------------------------------------------------
# Connection used once by `chotu bootstrap` to create or upgrade Chotu's
# own schema objects. Needs DDL on the Chotu schema only. See
# specs/0001-m1-trusted-fuel-logging/data-model.md for the minimum grants.
# For SQLite this is the same file URL as DATABASE_URL.
DATABASE_BOOTSTRAP_URL=file:./chotu.db

# --- API runtime ------------------------------------------------------
PORT=8787
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Auth --------------------------------------------------------------
# The bearer token is issued by `chotu bootstrap` and printed once.
# It is stored only as a hash. Put the printed value here for local use.
CHOTU_API_TOKEN=

# ===========================================================================
# Web SPA  (packages/web)  -- built after the API workflow is in production
# ===========================================================================
VITE_API_BASE_URL=http://localhost:8787

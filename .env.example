# Copy to .env.local (git-ignored) and fill in. Never commit real secrets.
# The schema of record is packages/api/src/env.ts.

# development | production. `production` requires PostgreSQL and blocks a
# seeded default-credential admin from serving traffic.
CHOTU_ENV=development

# Runtime DB connection (API role). Scheme picks the adapter:
#   postgres://user:pass@host:5432/chotu   (staging / production)
#   file:./chotu.db                        (local development only)
DATABASE_URL=file:./chotu.db

# Bootstrap DB connection (DDL role). For SQLite, same as DATABASE_URL.
DATABASE_BOOTSTRAP_URL=file:./chotu.db

PORT=8787

# Public base URL, used to build OIDC redirect URIs and emailed links.
CHOTU_BASE_URL=http://localhost:8787

# HMAC key for the session cookie. Generate: openssl rand -base64 32
SESSION_SIGNING_KEY=

# Comma-separated browser origins allowed to call the API. Empty for API-only.
CORS_ALLOWED_ORIGINS=

# true to read the client IP from the last X-Forwarded-For hop (behind a proxy).
TRUSTED_PROXY=false

# Optional rate-limit overrides (requests per window).
# RATE_LIMIT_SIGNIN_PER_MIN_IP=10
# RATE_LIMIT_SIGNIN_PER_MIN_ACCOUNT=5

# Optional SMTP. When unset, link tokens are returned in the API response
# (R-2 interim). See specs/research-backlog.md.
# EMAIL_SMTP_URL=
# EMAIL_FROM=chotu@example.com

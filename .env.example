# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real secret values.
# This file grows as the stack lands. Keep it in sync with the code.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Connection string for the database Chotu runs against.
# The local docker-compose stack (see CONTRIBUTING.md) serves this default.
DATABASE_URL=postgres://chotu:chotu@localhost:5432/chotu

# ---------------------------------------------------------------------------
# Schema bootstrap
# ---------------------------------------------------------------------------
# Credentials used once at startup to create or upgrade Chotu's own schema.
# This role needs create and alter rights on the Chotu schema only.
# See CONTRIBUTING.md for the minimum permission set.
DATABASE_BOOTSTRAP_URL=postgres://chotu_bootstrap:change-me@localhost:5432/chotu

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Secret used to sign sessions. Generate one with:
#   openssl rand -base64 32
APP_SECRET=replace-with-a-random-32-byte-value

# ---------------------------------------------------------------------------
# Client-safe values
# ---------------------------------------------------------------------------
# Any value that reaches the browser is PUBLIC. Never put a secret here.
# Server-only secrets must never get a browser-exposed prefix.
PUBLIC_APP_URL=http://localhost:3000
